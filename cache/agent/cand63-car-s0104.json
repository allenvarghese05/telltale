  "verdict": "LATE_HANDOFF",
  "claims": [
    {
      "text": "The struck vehicle became a hazard by entering the ego lane.",
      "type": "observation",
      "evidence": [
        "VID:hazard_onset_reason"
      ],
      "assertion": {
        "op": "is",
        "fact": "VID:hazard_onset_reason",
        "equals": "entering"
      }
    },
    {
      "text": "Perception took 0.12 s from hazard onset to first detection, below the 0.30 s perception threshold.",
      "type": "timing",
      "evidence": [
        "AV:first_seen_t",
        "VID:hazard_onset_t",
        "PROFILE:perception_threshold_s"
      ],
      "assertion": {
        "op": "diff",
        "a": "AV:first_seen_t",
        "b": "VID:hazard_onset_t",
        "equals": 0.119
      }
    },
    {
      "text": "The handoff decision occurred 4.43 s after first detection.",
      "type": "timing",
      "evidence": [
        "AV:handoff_t",
        "AV:first_seen_t"
      ],
      "assertion": {
        "op": "diff",
        "a": "AV:handoff_t",
        "b": "AV:first_seen_t",
        "equals": 4.4349
      }
    },
    {
      "text": "Only 0.72 s remained from handoff to impact, below the 1.50 s human perception-response time.",
      "type": "timing",
      "evidence": [
        "VID:impact_t",
        "AV:handoff_t",
        "PROFILE:human_prt_s"
      ],
      "assertion": {
        "op": "diff",
        "a": "VID:impact_t",
        "b": "AV:handoff_t",
        "equals": 0.7248
      }
    },
    {
      "text": "Brake actuation took 0.14 s from CAN brake request to pressure reached, below the 0.25 s actuation threshold.",
      "type": "timing",
      "evidence": [
        "CAN:pressure_reached_t",
        "CAN:brake_request_t",
        "PROFILE:actuation_threshold_s"
      ],
      "assertion": {
        "op": "diff",
        "a": "CAN:pressure_reached_t",
        "b": "CAN:brake_request_t",
        "equals": 0.14
      }
    },
    {
      "text": "The CAN brake request occurred after the video impact time.",
      "type": "timing",
      "evidence": [
        "CAN:brake_request_t",
        "VID:impact_t"
      ],
      "assertion": {
        "op": "gt",
        "fact": "CAN:brake_request_t",
        "than_fact": "VID:impact_t"
      }
    },
    {
      "text": "With nominal perception 0.20 s, command 0.05 s, and brake tau 0.15 s, the counterfactual simulation produced no contact and a minimum gap of 49.61 m.",
      "type": "physics",
      "evidence": [
        "CF:run1_contact",
        "CF:run1_min_gap_m",
        "PROFILE:nominal_perception_s",
        "PROFILE:nominal_command_s",
        "PROFILE:nominal_tau_s"
      ],
      "assertion": {
        "op": "is",
        "fact": "CF:run1_contact",
        "equals": false
      }
    },
    {
      "text": "The witness recheck agreed with the original witness that the other vehicle's brake lights were illuminated.",
      "type": "observation",
      "evidence": [
        "WIT:other_vehicle_brake_lights",
        "WIT2:other_vehicle_brake_lights"
      ],
      "assertion": {
        "op": "same",
        "a": "WIT:other_vehicle_brake_lights",
        "b": "WIT2:other_vehicle_brake_lights"
      }
    },
    {
      "text": "The brake log was complete for the decision window.",
      "type": "other",
      "evidence": [
        "DATA:brake_log_complete"
      ],
      "assertion": {
        "op": "is",
        "fact": "DATA:brake_log_complete",
        "equals": true
      }
    },
    {
      "text": "The primary contributing factor was the late handoff: the handoff-to-impact margin was 0.72 s, less than the 1.50 s human perception-response time, while the nominal-timing counterfactual avoided contact.",
      "type": "attribution",
      "evidence": [
        "VID:impact_t",
        "AV:handoff_t",
        "PROFILE:human_prt_s",
        "CF:run1_contact"
      ],
      "assertion": {
        "op": "diff",
        "a": "VID:impact_t",
        "b": "AV:handoff_t",
        "equals": 0.7248
      }
    }
