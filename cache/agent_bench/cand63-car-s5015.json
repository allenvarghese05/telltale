      "assertion": {
        "op": "diff",
        "a": "VID:impact_t",
        "b": "AV:first_seen_t",
        "equals": 5.1144
      }
    },
    {
      "text": "The handoff left a margin of 0.73 s from handoff to impact, below the 1.50 s human perception-response time. The primary contributing factor was the late handoff.",
      "type": "attribution",
      "evidence": [
        "VID:impact_t",
        "AV:handoff_t",
        "PROFILE:human_prt_s"
      ],
      "assertion": {
        "op": "diff",
        "a": "VID:impact_t",
        "b": "AV:handoff_t",
        "equals": 0.7302
      }
    },
    {
      "text": "The first CAN brake request occurred 0.80 s after impact.",
      "type": "timing",
      "evidence": [
        "CAN:brake_request_t",
        "VID:impact_t"
      ],
      "assertion": {
        "op": "diff",
        "a": "CAN:brake_request_t",
        "b": "VID:impact_t",
        "equals": 0.8017
      }
    },
    {
      "text": "Brake pressure was reached 0.12 s after the brake request, below the 0.25 s actuation threshold.",
      "type": "timing",
      "evidence": [
        "CAN:pressure_reached_t",
        "CAN:brake_request_t",
        "PROFILE:actuation_threshold_s"
      ],
      "assertion": {
        "op": "diff",
        "a": "CAN:pressure_reached_t",
        "b": "CAN:brake_request_t",
        "equals": 0.12
      }
    },
    {
      "text": "Using nominal perception 0.20 s, nominal command 0.05 s and nominal tau 0.15 s, the counterfactual replay avoided contact.",
      "type": "physics",
      "evidence": [
        "PROFILE:nominal_perception_s",
        "PROFILE:nominal_command_s",
        "PROFILE:nominal_tau_s",
        "CF:run1_contact"
      ],
      "assertion": {
        "op": "is",
        "fact": "CF:run1_contact",
        "equals": false
      }
    },
    {
      "text": "Both the original witness and the independent recheck reported yes for the other vehicle's brake lights.",
      "type": "observation",
      "evidence": [
        "WIT:other_vehicle_brake_lights",
        "WIT2:other_vehicle_brake_lights"
      ],
      "assertion": {
