      ],
      "assertion": {
        "op": "is",
        "fact": "VID:hazard_onset_reason",
        "equals": "entering"
      }
    },
    {
      "text": "Perception took 0.16 s from hazard onset to first detection, below the 0.30 s perception threshold.",
      "type": "timing",
      "evidence": [
