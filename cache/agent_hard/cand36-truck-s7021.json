    },
    {
      "text": "The handoff left 1.0875 s before impact, below the human perception-response threshold of 1.5 s.",
      "type": "timing",
      "evidence": [
        "VID:impact_t",
        "AV:handoff_t",
        "PROFILE:human_prt_s"
      ],
      "assertion": {
        "op": "diff",
        "a": "VID:impact_t",
        "b": "AV:handoff_t",
        "equals": 1.0875
      }
    },
    {
      "text": "The CAN brake request was recorded at 8.3617 s, after the impact at 8.0 s.",
