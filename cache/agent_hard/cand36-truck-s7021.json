      "evidence": [
        "CAN:brake_request_t",
        "VID:impact_t"
      ],
      "assertion": {
        "op": "gt",
        "fact": "CAN:brake_request_t",
        "than_fact": "VID:impact_t"
      }
    },
    {
      "text": "Brake actuation took 0.32 s from the CAN brake request to pressure, within the actuation threshold of 0.45 s.",
      "type": "timing",
      "evidence": [
        "CAN:pressure_reached_t",
        "CAN:brake_request_t",
        "PROFILE:actuation_threshold_s"
      ],
      "assertion": {
        "op": "diff",
        "a": "CAN:pressure_reached_t",
        "b": "CAN:brake_request_t",
        "equals": 0.32
      }
    },
    {
      "text": "The brake log was complete.",
      "type": "other",
      "evidence": [
        "DATA:brake_log_complete"
      ],
      "assertion": {
        "op": "is",
        "fact": "DATA:brake_log_complete",
        "equals": true
      }
    },
    {
      "text": "With nominal perception of 0.2 s, nominal command of 0.05 s, and nominal tau of 0.35 s, the counterfactual had no contact and a minimum gap of 3.3761 m.",
      "type": "physics",
      "evidence": [
        "CF:run1_contact",
        "CF:run1_min_gap_m",
        "PROFILE:nominal_perception_s",
        "PROFILE:nominal_command_s",
        "PROFILE:nominal_tau_s"
      ],
      "assertion": {
        "op": "is",
        "fact": "CF:run1_contact",
        "equals": false
      }
    },
    {
      "text": "The primary timing failure was the late handoff: the remaining 1.0875 s was below the 1.5 s human perception-response threshold.",
      "type": "attribution",
      "evidence": [
        "VID:impact_t",
        "AV:handoff_t",
